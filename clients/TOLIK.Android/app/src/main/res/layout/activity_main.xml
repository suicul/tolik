<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Connection status header (thin client: reflects Core state, decides nothing). -->
    <LinearLayout
        android:id="@+id/status_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface_variant"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="6dp">

        <TextView
            android:id="@+id/status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/status_disconnected"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/md_theme_on_surface_variant" />

        <Button
            android:id="@+id/status_refresh_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:text="@string/status_refresh"
            android:textSize="12sp" />

        <Button
            android:id="@+id/settings_button"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:text="@string/settings_title"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Display mode switcher (Companion/Presence/Conversation/Voice/Compact). -->
    <LinearLayout
        android:id="@+id/mode_switcher"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface_variant"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingBottom="4dp">

        <Button
            android:id="@+id/mode_companion"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:minWidth="0dp"
            android:text="@string/mode_companion"
            android:textSize="10sp" />

        <Button
            android:id="@+id/mode_presence"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:minWidth="0dp"
            android:text="@string/mode_presence"
            android:textSize="10sp" />

        <Button
            android:id="@+id/mode_conversation"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:minWidth="0dp"
            android:text="@string/mode_conversation"
            android:textSize="10sp" />

        <Button
            android:id="@+id/mode_voice"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:minWidth="0dp"
            android:text="@string/mode_voice"
            android:textSize="10sp" />

        <Button
            android:id="@+id/mode_compact"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="2dp"
            android:minWidth="0dp"
            android:text="@string/mode_compact"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- Cephalon presence surface (AN-P2): procedural renderer + honest status.
         Weight is set per display mode by MainActivity. The fixed deep-space
         backdrop (renderer palette is theme-independent, docs/android-app.md
         §3) avoids a white flash before the first surface frame in light mode. -->
    <FrameLayout
        android:id="@+id/cephalon_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.42"
        android:background="@color/cephalon_backdrop">

        <com.tolik.client.CephalonView
            android:id="@+id/cephalon_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Honest status line: connection + last expression age (never fake).
             Fixed light text on the fixed dark pill — readable in both themes. -->
        <TextView
            android:id="@+id/cephalon_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="8dp"
            android:background="@color/cephalon_status_backdrop"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="@string/cephalon_status_offline"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/cephalon_status_text" />

        <!-- Exit from Fullscreen Presence (the only chrome there). -->
        <Button
            android:id="@+id/cephalon_exit"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="8dp"
            android:minWidth="0dp"
            android:text="@string/cephalon_exit_presence"
            android:textSize="11sp"
            android:visibility="gone" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/content_frame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.58">

        <!-- ── Chat screen ─────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/screen_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/chat_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="8dp" />

            <ProgressBar
                android:id="@+id/chat_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:indeterminate="true"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <EditText
                    android:id="@+id/chat_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/chat_input_hint"
                    android:imeOptions="actionSend"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="4" />

                <Button
                    android:id="@+id/chat_send"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/chat_send" />
            </LinearLayout>

            <!-- Voice entry (Companion mode only — Conversation hides it). -->
            <Button
                android:id="@+id/chat_voice_entry"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="4dp"
                android:text="@string/voice_start" />
        </LinearLayout>

        <!-- ── Voice screen ────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/screen_voice"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/voice_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:text="@string/voice_idle"
                android:textAppearance="?attr/textAppearanceTitleMedium" />

            <TextView
                android:id="@+id/voice_transcript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/md_theme_on_surface_variant" />

            <TextView
                android:id="@+id/voice_reply"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:scrollbars="vertical"
                android:textAppearance="?attr/textAppearanceBodyLarge" />

            <TextView
                android:id="@+id/voice_speaker_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                android:textColor="@color/md_theme_on_surface_variant"
                android:visibility="gone" />

            <Button
                android:id="@+id/voice_cancel_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/voice_cancel"
                android:visibility="gone" />

            <Button
                android:id="@+id/voice_toggle_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/voice_start" />
        </LinearLayout>

        <!-- ── Tasks screen ────────────────────────────────────────────── -->
        <LinearLayout
            android:id="@+id/screen_tasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp">

                <EditText
                    android:id="@+id/task_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="@string/tasks_new_hint"
                    android:inputType="text"
                    android:maxLines="1" />

                <Button
                    android:id="@+id/task_create_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="@string/tasks_create" />
            </LinearLayout>

            <TextView
                android:id="@+id/tasks_empty_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:padding="16dp"
                android:text="@string/tasks_empty"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/md_theme_on_surface_variant" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/task_list"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="8dp" />
        </LinearLayout>

        <!-- Compact mode: a small state widget leaves the rest minimal. -->
        <TextView
            android:id="@+id/compact_hint"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/compact_hint"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/md_theme_on_surface_variant"
            android:visibility="gone" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottom_nav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:menu="@menu/bottom_nav_menu" />
</LinearLayout>
