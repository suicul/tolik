<?xml version="1.0" encoding="utf-8"?>
<!-- Device transfer (API 31+): same policy as backup_rules.xml — session token
     and device identity never leave the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="tolik_session.xml" />
        <exclude domain="sharedpref" path="tolik_device.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="tolik_session.xml" />
        <exclude domain="sharedpref" path="tolik_device.xml" />
    </device-transfer>
</data-extraction-rules>
