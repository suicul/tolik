<?xml version="1.0" encoding="utf-8"?>
<!-- TOLIK Android thin client (AGENTS.md §36). The device is an untrusted client:
     it authenticates to Core with a Core-issued session token and never makes
     authorization decisions locally (SECURITY & TRUST MODEL §1). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Transport to TOLIK Core. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Voice input: runtime-requested, never silent (§26 privacy-first). Capture
         only runs while the user holds/starts a voice turn on screen. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Task/confirmation notifications: runtime-requested on API 33+. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Tolik"
        android:networkSecurityConfig="@xml/network_security_config">

        <!-- The single Activity (thin client: no Core logic duplication). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
