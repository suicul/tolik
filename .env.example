# TOLIK configuration — copy to .env and fill in secrets.
# NEVER commit .env (passwords, bootstrap codes, API keys).
# Keys below match what the code actually reads (ModelRouter, Program.cs,
# docker-compose.yml). Single underscore ":" and double "__" are equivalent.

# --- PostgreSQL (required; compose fails fast without the password) ---
TOLIK_POSTGRES_PASSWORD=<your-secure-password>
TOLIK_POSTGRES_PORT=5432

# --- Bootstrap (first-time device enrollment; keep secret) ---
TOLIK_BOOTSTRAP_CODE=

# --- Core ---
TOLIK_CORE_PORT=5080
TOLIK_SESSION_LIFETIME_HOURS=168

# --- Dev convenience: NEVER enable on shared/VPS hosts ---
# Allows the same-machine WebUI to mint owner sessions via GET /auth/local-token.
TOLIK_DEV_AUTO_TOKEN=false

# --- Agent filesystem allowlist (agent-side; empty = no filesystem tools) ---
TOLIK_ALLOWED_ROOTS=C:\DEV\TOLIK_QWEN

# --- Models: offline Ollama (Cloud AI first per §6, local later) ---
TOLIK_OFFLINE_MODE=true
TOLIK_MODEL_OFFLINE__PROVIDER=ollama
TOLIK_MODEL_OFFLINE__ENDPOINT=http://host.docker.internal:11434
TOLIK_MODEL_OFFLINE__MODEL=qwen2.5:3b-instruct
# Per-kind overrides (fall back to the section above when unset):
TOLIK_MODEL_OFFLINE_SIMPLE__MODEL=qwen3:4b
TOLIK_MODEL_OFFLINE_CODING__MODEL=qwen3.6:35b-coding
# Compose shorthand (mapped to the __ENDPOINT/__MODEL keys above):
# TOLIK_MODEL_OFFLINE_ENDPOINT=http://host.docker.internal:11434
# TOLIK_MODEL_OFFLINE_MODEL=qwen2.5:3b-instruct
# TOLIK_MODEL_OFFLINE_CODING__MODEL=qwen3.6:35b-coding

# --- Models: cloud (OpenAI-compatible; read only when TOLIK_OFFLINE_MODE=false
# or as fallback via ResolveWithFallback). NOTE the TOLIK_MODELS_ prefix. ---
# TOLIK_MODELS_SIMPLE__PROVIDER=
# TOLIK_MODELS_SIMPLE__MODEL=
# TOLIK_MODELS_SIMPLE__ENDPOINT=
# TOLIK_MODELS_SIMPLE__API_KEY=
# (same shape for TOLIK_MODELS_REASONING__, TOLIK_MODELS_CODING__, TOLIK_MODELS_VISION__)

# --- Voice service ---
TOLIK_TTS_ENGINE=auto
# Local neural voice (XTTS-v2 GPU sidecar, opt-in):
#   1. docker compose --profile vps --profile gpu up -d --build xtts
#   2. TOLIK_XTTS_ENDPOINT=http://xtts:9670
#   3. restart voice (docker compose --profile vps up -d --force-recreate voice)
# Demos: artifacts/voice-demos/xtts_ordis_*.wav (verify by ear before enabling).
# TOLIK_XTTS_ENDPOINT=
# Cephalon character DSP over any TTS output (off|cephalon). Hear samples in
# artifacts/voice-demos/ before enabling (base: espeak here, Dmitry where reachable).
# TOLIK_VOICE_DSP=off
# TOLIK_VOICE_GLITCH=0.18
# TOLIK_VOICE__COSYVOICE_ENDPOINT=http://voice:9660
# TOLIK_VOICE__COSYVOICE_TIMEOUT=60000
# TOLIK_VOICE__COSYVOICE_MAX_AUDIO_BYTES=10485760
# TOLIK_STT_ENDPOINT=http://voice:9660
# TOLIK_COSYVOICE_ENDPOINT=http://voice:9660
