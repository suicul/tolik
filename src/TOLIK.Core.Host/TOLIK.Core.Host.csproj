<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Core serves no UI: the web page was removed from the product 03.11.2026
         (Windows client is the main client, interface/ is reference only). Without this,
         the Web SDK still emits a static-asset manifest that points at the now-absent
         wwwroot and fails host startup with DirectoryNotFoundException. -->
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="..\TOLIK.Core\TOLIK.Core.csproj" />
    <ProjectReference Include="..\TOLIK.Infrastructure\TOLIK.Infrastructure.csproj" />
  </ItemGroup>

</Project>
