<Window x:Class="TOLIK.Desktop.CephalonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:rendering="clr-namespace:TOLIK.Desktop.Rendering"
        Title="TOLIK Cephalon"
        Width="380" Height="380"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual">
    <rendering:CephalonHost x:Name="Host" />
</Window>
