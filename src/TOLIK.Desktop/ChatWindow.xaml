<Window x:Class="TOLIK.Desktop.ChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Толик"
        Width="520" Height="660"
        MinWidth="380" MinHeight="420"
        WindowStartupLocation="CenterScreen"
        Background="#0C1322"
        Foreground="#DCE6F5"
        FontFamily="Segoe UI"
        FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#111A2C" />
        <SolidColorBrush x:Key="LineBrush" Color="#1E2C46" />
        <SolidColorBrush x:Key="MutedBrush" Color="#7E90AD" />
        <SolidColorBrush x:Key="AccentBrush" Color="#58A6FF" />

        <Style x:Key="SendButton" TargetType="Button">
            <Setter Property="Background" Value="#1B2A45" />
            <Setter Property="Foreground" Value="#DCE6F5" />
            <Setter Property="BorderBrush" Value="#2C3F62" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#24395C" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: identity of the surface + the honest link state. -->
        <Border Grid.Row="0" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="9" Height="9" Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="Толик" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="LinkLabel" Text="соединение…"
                           Foreground="{StaticResource MutedBrush}" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Transcript -->
        <ScrollViewer Grid.Row="1" x:Name="TranscriptScroll" VerticalScrollBarVisibility="Auto"
                      Padding="14,12">
            <ItemsControl x:Name="Transcript">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Bubble" CornerRadius="8" Padding="11,8" Margin="0,0,0,9"
                                MaxWidth="440" HorizontalAlignment="Left"
                                Background="#16223A">
                            <StackPanel>
                                <TextBlock x:Name="Author" Text="" FontSize="11"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,0,0,3" />
                                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Role}" Value="Owner">
                                <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Bubble" Property="Background" Value="#1D3355" />
                                <Setter TargetName="Author" Property="Text" Value="Вы" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Role}" Value="Tolik">
                                <Setter TargetName="Author" Property="Text" Value="Толик" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Role}" Value="Notice">
                                <Setter TargetName="Bubble" Property="Background" Value="Transparent" />
                                <Setter TargetName="Bubble" Property="BorderBrush" Value="#4A2C36" />
                                <Setter TargetName="Bubble" Property="BorderThickness" Value="1" />
                                <Setter TargetName="Author" Property="Text" Value="—" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Status: "думает…" is a real state, not decoration. -->
        <TextBlock Grid.Row="2" x:Name="StatusLabel" Text="" Margin="16,0,16,6"
                   Foreground="{StaticResource MutedBrush}" FontSize="12" />

        <!-- Composer -->
        <Border Grid.Row="3" Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="MicButton" Grid.Column="0" Content="🎤"
                        Style="{StaticResource SendButton}" Margin="0,0,8,0"
                        ToolTip="Нажмите и говорите — Толик слушает микрофон этого ПК"
                        Click="OnMicClick" />
                <TextBox x:Name="Input" Grid.Column="1"
                         Background="#0B1524" Foreground="#DCE6F5"
                         BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                         Padding="10,8" VerticalContentAlignment="Center"
                         AcceptsReturn="False" TextWrapping="NoWrap"
                         CaretBrush="#DCE6F5"
                         PreviewKeyDown="OnInputPreviewKeyDown" />
                <Button x:Name="SendButtonControl" Grid.Column="2" Content="Отправить"
                        Style="{StaticResource SendButton}" Margin="10,0,0,0"
                        Click="OnSendClick" />
            </Grid>
        </Border>
    </Grid>
</Window>
