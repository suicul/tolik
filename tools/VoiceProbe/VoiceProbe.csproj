<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>TOLIK.VoiceProbe</RootNamespace>
  </PropertyGroup>

  <!-- Deliberately NOT in TOLIK.sln: this is a dev-only probe that drives the same
       transport the Windows client uses, so a live voice turn can be verified end to
       end without a microphone. Keeping it out of the solution keeps the build and
       the test run unchanged. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\TOLIK.Desktop\TOLIK.Desktop.csproj" />
  </ItemGroup>

</Project>
